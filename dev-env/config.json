{
  "client": {
    "token": {
      "hmac_secret_key": "your-secret-key-must-be-at-least-256-bits-long"
    },
    "allowed_origins": ["*"]
  },

  "http_api": {
    "key": "api_key"
  },

  "admin": {
    "enabled": true,
    "password": "admin",
    "secret": "admin_secret"
  },

  "engine": {
    "type": "redis",
    "redis": {
      "address": "redis:6379",
      "password": "strongpassword"
    }
  },

  "channel": {
    "namespaces": [
      {
        "name": "chat",
        "allow_publish_for_client": false,
        "allow_subscribe_for_client": true,

        "history_size": 1000,
        "history_ttl": "72h"
      }
    ]
  }
}
